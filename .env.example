# Neon Postgres (pooled connection string from the Neon console / MCP)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon Auth (Project -> Auth in the Neon console)
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-a-32+-char-random-string

# Playwright e2e accounts (one per role; created in Neon Auth, role set in the DB)
E2E_STUDENT_EMAIL=student@example.com
E2E_STUDENT_PASSWORD=change-me
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me
E2E_WELFARE_EMAIL=welfare@example.com
E2E_WELFARE_PASSWORD=change-me
# Optional: test an already-running deployment instead of building locally
# ISC_BASE_URL=http://localhost:3000
